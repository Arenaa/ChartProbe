{
  "version": 1,
  "description": "ChartProbe question templates. Edit this file (or pass --templates PATH) to define your own probes. Generators import via src/templates.py.",
  "families": {
    "bar": {
      "questions_per_sample": 9,
      "templates": [
        {
          "template_id": "P-COUNT-ABOVE-AVG",
          "stage": "Perception",
          "category": "count",
          "question_template": "How many bars appear to be above the average height?",
          "answer_type": "count",
          "answer_rule": "count of bar values strictly greater than mean"
        },
        {
          "template_id": "P-HEIGHT-2X",
          "stage": "Perception",
          "category": "height",
          "question_template": "Is the largest bar more than twice the size of the smallest bar?",
          "answer_type": "binary",
          "answer_rule": "Yes if max > 2 * min, else No"
        },
        {
          "template_id": "P-TREND-PATTERN",
          "stage": "Perception",
          "category": "trend",
          "question_template": "What is the overall trend of the bars from left to right?",
          "answer_type": "open",
          "answer_rule": "Consistently increasing | Consistently decreasing | Neither consistently increasing nor decreasing"
        },
        {
          "template_id": "G-BBOX-ELEMENT",
          "stage": "Grounding",
          "category": "bbox",
          "question_template": "What is the bounding box of the bar for {label}?",
          "answer_type": "bbox",
          "answer_rule": "[x0,y0,x1,y1] xyxy_1000 of tallest bar by value"
        },
        {
          "template_id": "G-VT-LEFTMOST",
          "stage": "Grounding",
          "category": "value_to_label",
          "question_template": "What is the {label_col} of the leftmost bar?",
          "answer_type": "label",
          "answer_rule": "label of leftmost bar (bbox sort)"
        },
        {
          "template_id": "G-TV-VALUE-B",
          "stage": "Grounding",
          "category": "value_lookup",
          "question_template": "What is the {value_col} for {label}?",
          "answer_type": "value",
          "answer_rule": "numeric value of 2nd-largest bar"
        },
        {
          "template_id": "R-RANK-TOP3",
          "stage": "Reasoning",
          "category": "rank",
          "question_template": "What are the top 3 {label_col_plural} by {value_col}?",
          "answer_type": "open",
          "answer_rule": "comma-separated top-3 labels by value"
        },
        {
          "template_id": "R-ARITH-TOTAL",
          "stage": "Reasoning",
          "category": "arithmetic",
          "question_template": "What is the total {value_col} across all bars combined?",
          "answer_type": "value",
          "answer_rule": "sum of all bar values"
        },
        {
          "template_id": "R-MULTI-DIFF-MEAN",
          "stage": "Reasoning",
          "category": "multi_step",
          "question_template": "How much higher is {top_label} compared to the average {value_col}?",
          "answer_type": "value",
          "answer_rule": "top_value - mean(values)"
        }
      ]
    },
    "pie": {
      "questions_per_sample": 9,
      "templates": [
        {
          "template_id": "P-COUNT-ABOVE-AVG",
          "stage": "Perception",
          "category": "count",
          "question_template": "How many segments appear to be above the average size?",
          "answer_type": "count",
          "answer_rule": "count of wedge values strictly greater than mean"
        },
        {
          "template_id": "P-HEIGHT-2X",
          "stage": "Perception",
          "category": "height",
          "question_template": "Is the largest segment more than twice the size of the smallest segment?",
          "answer_type": "binary",
          "answer_rule": "Yes if max > 2 * min, else No"
        },
        {
          "template_id": "P-TREND-PATTERN",
          "stage": "Perception",
          "category": "trend",
          "question_template": "What is the overall trend of the segments clockwise from the top?",
          "answer_type": "open",
          "answer_rule": "same trend labels as bar charts on clockwise wedge order"
        },
        {
          "template_id": "G-BBOX-ELEMENT",
          "stage": "Grounding",
          "category": "bbox",
          "question_template": "What is the bounding box of the pie segment for {label}?",
          "answer_type": "bbox",
          "answer_rule": "[x0,y0,x1,y1] xyxy_1000 of largest wedge"
        },
        {
          "template_id": "G-VT-LARGEST",
          "stage": "Grounding",
          "category": "value_to_label",
          "question_template": "What is the {label_col} of the largest segment?",
          "answer_type": "label",
          "answer_rule": "label of largest wedge by value"
        },
        {
          "template_id": "G-TV-VALUE-B",
          "stage": "Grounding",
          "category": "value_lookup",
          "question_template": "What is the {value_col} for {label}?",
          "answer_type": "value",
          "answer_rule": "numeric value of 2nd-largest wedge"
        },
        {
          "template_id": "R-RANK-TOP3",
          "stage": "Reasoning",
          "category": "rank",
          "question_template": "What are the top 3 {label_col_plural} by {value_col}?",
          "answer_type": "open",
          "answer_rule": "comma-separated top-3 labels by value"
        },
        {
          "template_id": "R-ARITH-TOTAL",
          "stage": "Reasoning",
          "category": "arithmetic",
          "question_template": "What is the total {value_col} across all segments combined?",
          "answer_type": "value",
          "answer_rule": "sum of all wedge values"
        },
        {
          "template_id": "R-MULTI-DIFF-MEAN",
          "stage": "Reasoning",
          "category": "multi_step",
          "question_template": "How much higher is {top_label} compared to the average {value_col}?",
          "answer_type": "value",
          "answer_rule": "top_value - mean(values)"
        }
      ]
    },
    "clevr": {
      "questions_per_sample": 9,
      "test_set_selection": {
        "Perception": {
          "count_total": "P-COUNT-TOTAL",
          "count_size": "P-COUNT-LARGE",
          "count_shape": "P-COUNT-{SHAPE}"
        },
        "Grounding": {
          "bbox": "G-BBOX-ELEMENT",
          "attribute": "G-ATTR-COLOR",
          "spatial": "G-SPATIAL-LR"
        },
        "Reasoning": {
          "compare": "R-COMPARE-LARGE-SMALL",
          "open_count": "R-MATERIAL-COUNT",
          "relation": "R-SAME-MATERIAL"
        }
      },
      "templates": [
        {
          "template_id": "P-COUNT-TOTAL",
          "stage": "Perception",
          "category": "count_total",
          "question_template": "How many objects are in the scene?",
          "answer_type": "count"
        },
        {
          "template_id": "P-COUNT-LARGE",
          "stage": "Perception",
          "category": "count_size",
          "question_template": "How many large objects are in the scene?",
          "answer_type": "count"
        },
        {
          "template_id": "P-COUNT-CUBE",
          "stage": "Perception",
          "category": "count_shape",
          "question_template": "How many cubes are in the scene?",
          "answer_type": "count"
        },
        {
          "template_id": "P-COUNT-SPHERE",
          "stage": "Perception",
          "category": "count_shape",
          "question_template": "How many spheres are in the scene?",
          "answer_type": "count"
        },
        {
          "template_id": "P-COUNT-CYLINDER",
          "stage": "Perception",
          "category": "count_shape",
          "question_template": "How many cylinders are in the scene?",
          "answer_type": "count"
        },
        {
          "template_id": "P-COUNT-{SHAPE}",
          "stage": "Perception",
          "category": "count_shape",
          "question_template": "How many {shape}s are in the scene?",
          "answer_type": "count",
          "notes": "Resolved at generation time to the most frequent shape"
        },
        {
          "template_id": "G-BBOX-ELEMENT",
          "stage": "Grounding",
          "category": "bbox",
          "question_template": "What is the bounding box of the {target}?",
          "answer_type": "bbox"
        },
        {
          "template_id": "G-ATTR-COLOR",
          "stage": "Grounding",
          "category": "attribute",
          "question_template": "What color is the {anchor}?",
          "answer_type": "label"
        },
        {
          "template_id": "G-SPATIAL-LR",
          "stage": "Grounding",
          "category": "spatial",
          "question_template": "Is the {obj_a} to the left or to the right of the {obj_b}?",
          "answer_type": "open"
        },
        {
          "template_id": "R-COMPARE-LARGE-SMALL",
          "stage": "Reasoning",
          "category": "compare",
          "question_template": "Are there more large objects than small objects?",
          "answer_type": "binary"
        },
        {
          "template_id": "R-MATERIAL-COUNT",
          "stage": "Reasoning",
          "category": "open_count",
          "question_template": "Are there more metal objects or rubber objects?",
          "answer_type": "open"
        },
        {
          "template_id": "R-SAME-MATERIAL",
          "stage": "Reasoning",
          "category": "relation",
          "question_template": "Is the {anchor_a} made of the same material as the {anchor_b}?",
          "answer_type": "binary"
        }
      ]
    }
  }
}
