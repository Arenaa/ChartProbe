{
  "version": 2,
  "description": "Summary catalog derived from question_templates.json",
  "source_templates": "src/question_templates.json",
  "generator": "src/build_question_templates_catalog.py",
  "selection_rule": "Each 9-Q sample uses exactly one fixed template per stage category (3 Perception + 3 Grounding + 3 Reasoning).",
  "template_families": {
    "bar": {
      "questions_per_sample": 9,
      "templates": [
        {
          "template_id": "P-COUNT-ABOVE-AVG",
          "stage": "Perception",
          "category": "count",
          "question_template": "How many bars appear to be above the average height?",
          "answer_type": "count",
          "answer_rule": "count of bar values strictly greater than mean"
        },
        {
          "template_id": "P-HEIGHT-2X",
          "stage": "Perception",
          "category": "height",
          "question_template": "Is the largest bar more than twice the size of the smallest bar?",
          "answer_type": "binary",
          "answer_rule": "Yes if max > 2 * min, else No"
        },
        {
          "template_id": "P-TREND-PATTERN",
          "stage": "Perception",
          "category": "trend",
          "question_template": "What is the overall trend of the bars from left to right?",
          "answer_type": "open",
          "answer_rule": "Consistently increasing | Consistently decreasing | Neither consistently increasing nor decreasing"
        },
        {
          "template_id": "G-BBOX-ELEMENT",
          "stage": "Grounding",
          "category": "bbox",
          "question_template": "What is the bounding box of the bar for {label}?",
          "answer_type": "bbox",
          "answer_rule": "[x0,y0,x1,y1] xyxy_1000 of tallest bar by value"
        },
        {
          "template_id": "G-VT-LEFTMOST",
          "stage": "Grounding",
          "category": "value_to_label",
          "question_template": "What is the {label_col} of the leftmost bar?",
          "answer_type": "label",
          "answer_rule": "label of leftmost bar (bbox sort)"
        },
        {
          "template_id": "G-TV-VALUE-B",
          "stage": "Grounding",
          "category": "value_lookup",
          "question_template": "What is the {value_col} for {label}?",
          "answer_type": "value",
          "answer_rule": "numeric value of 2nd-largest bar"
        },
        {
          "template_id": "R-RANK-TOP3",
          "stage": "Reasoning",
          "category": "rank",
          "question_template": "What are the top 3 {label_col_plural} by {value_col}?",
          "answer_type": "open",
          "answer_rule": "comma-separated top-3 labels by value"
        },
        {
          "template_id": "R-ARITH-TOTAL",
          "stage": "Reasoning",
          "category": "arithmetic",
          "question_template": "What is the total {value_col} across all bars combined?",
          "answer_type": "value",
          "answer_rule": "sum of all bar values"
        },
        {
          "template_id": "R-MULTI-DIFF-MEAN",
          "stage": "Reasoning",
          "category": "multi_step",
          "question_template": "How much higher is {top_label} compared to the average {value_col}?",
          "answer_type": "value",
          "answer_rule": "top_value - mean(values)"
        }
      ]
    },
    "pie": {
      "questions_per_sample": 9,
      "templates": [
        {
          "template_id": "P-COUNT-ABOVE-AVG",
          "stage": "Perception",
          "category": "count",
          "question_template": "How many segments appear to be above the average size?",
          "answer_type": "count",
          "answer_rule": "count of wedge values strictly greater than mean"
        },
        {
          "template_id": "P-HEIGHT-2X",
          "stage": "Perception",
          "category": "height",
          "question_template": "Is the largest segment more than twice the size of the smallest segment?",
          "answer_type": "binary",
          "answer_rule": "Yes if max > 2 * min, else No"
