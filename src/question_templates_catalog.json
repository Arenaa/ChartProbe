        },
        {
          "template_id": "R-MULTI-DIFF-MEAN",
          "stage": "Reasoning",
          "category": "multi_step",
          "question_template": "How much higher is {top_label} compared to the average {value_col}?",
          "answer_type": "value",
          "answer_rule": "top_value - mean(values)"
        }
      ]
    },
